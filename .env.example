# ---- Mock API (apps/server) ----
SERVER_HOST=0.0.0.0
SERVER_PORT=3001
# Seed генератора данных: одинаковый seed — одинаковая орг-структура
MOCK_SEED=20260914
# debug | info | warn | error
LOG_LEVEL=info
# Разрешённый Origin для CORS. Не нужен: в dev проксирует Vite, в prod — nginx
CORS_ORIGIN=
# Live-обновления: период генерации изменений (0 — выключить), узлов за патч, heartbeat, буфер досылки
UPDATE_INTERVAL_MS=3000
UPDATE_BATCH_MAX=3
HEARTBEAT_MS=10000
PATCH_BUFFER_SIZE=500

# ---- Клиент (apps/web) ----
# Порт dev-сервера Vite; /api и /ws проксируются на SERVER_PORT
WEB_DEV_PORT=5173
